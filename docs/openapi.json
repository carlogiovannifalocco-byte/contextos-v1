    "/api/v1/projects/{id}/context-package": {
      "get": {
        "summary": "Compiled context brief for agents",
        "tags": [
          "projects"
        ],
        "description": "Ranks shared memory by priority and relevance, drops superseded entries, and packs the result into a token budget. Use format=md to get a brief you can paste straight into a prompt.",
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 200,
              "maximum": 32000,
              "default": 2000,
              "example": 2000
            },
            "in": "query",
            "name": "budget",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "example": "ignore file syntax"
            },
            "in": "query",
            "name": "focus",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "json",
                "md"
              ],
              "default": "json"
            },
            "in": "query",
            "name": "format",
            "required": false
          },
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "id",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response"
          }
        }
      }
    },
