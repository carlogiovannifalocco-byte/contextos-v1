{
  "name": "contextos-memory",
  "version": "1.0.0-beta",
  "description": "Wire a repo and its AI coding agents to ContextOS with one command.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "contextos",
    "mcp",
    "ai-agents",
    "cursor",
    "claude-code",
    "memory",
    "context",
    "coding-agents"
  ],
  "bin": {
    "contextos": "./dist/index.js",
    "contextos-mcp": "./dist/mcp/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node ../../scripts/copy-mcp.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/carlogiovannifalocco-byte/contextos-v1.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/carlogiovannifalocco-byte/contextos-v1/issues"
  },
  "homepage": "https://github.com/carlogiovannifalocco-byte/contextos-v1#readme",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.7.3",
    "vitest": "^3.0.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^4.4.3"
  }
}
