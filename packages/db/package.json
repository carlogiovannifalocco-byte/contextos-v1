{
  "name": "@contextos/db",
  "version": "1.0.0-beta",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "prisma generate && node ../../scripts/sync-prisma-client.mjs",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx src/seed.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@contextos/shared": "*",
    "@prisma/client": "^6.12.0",
    "argon2": "^0.41.1",
    "prisma": "6.12.0"
  },
  "devDependencies": {
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
