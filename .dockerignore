# Host build artifacts must never reach the image. These patterns need the **/
# prefix: a bare "node_modules" only matches the context root, which would let
# apps/*/node_modules and packages/*/node_modules through -- including the
# Windows-native Prisma engine in packages/db/node_modules/.prisma.
**/node_modules
**/dist
**/coverage
**/.cache
**/.vite
**/.vite-temp
**/*.tsbuildinfo

.git
.github
.gitattributes
.gitignore

# Secrets: never bake an env file into an image layer.
.env
.env.*
!.env.example

playwright-report
test-results
e2e/playwright-report
e2e/test-results
docs
*.log
.vscode
.idea
.DS_Store
Thumbs.db
