# Copy to .env for local development. Never commit .env.
# Generate COOKIE_SECRET: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"

NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://contextos:contextos@localhost:5432/contextos
COOKIE_SECRET=dev-only-change-me-use-32-plus-chars!!
PUBLIC_WEB_ORIGIN=http://localhost:5173
# Production HTTP (docker compose on :8080) keeps cookies non-Secure unless you set:
# COOKIE_SECURE=true
# and serve HTTPS. Production also requires Origin to match PUBLIC_WEB_ORIGIN on cookie mutations.
# Comma-separated extra origins allowed for CORS (optional)
# CORS_ORIGINS=http://localhost:8080

# Optional: seed demo user password override
# SEED_PASSWORD=DemoPassw0rd!

# Production compose requires COOKIE_SECRET of at least 32 characters.
# Encryption at rest is NOT implemented. Do not set this expecting disk encryption.
